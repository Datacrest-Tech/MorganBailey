# Copy this file to .env for local development (used by `vercel dev`), and
# add the same variables under Project Settings → Environment Variables in
# the Vercel dashboard for production. One set of variables powers the
# Contact, Request a Quote, and Careers forms — they all share this SMTP
# connection.

# --- SMTP (used by /api/contact, /api/quote, /api/careers) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_TO=morgan@morgan-baileyng.com
MAIL_FROM="Morgan Bailey Website" <no-reply@morgan-baileyng.com>

# --- Frontend ---
# Leave unset. The frontend calls /api/... as a relative path since it's
# deployed on the same domain as the API functions. Only set this if you
# ever point the frontend at an API hosted elsewhere.
# VITE_API_URL=
